{
  "name": "vscode-worktree",
  "displayName": "Git Worktrees",
  "description": "One VS Code window per git worktree: create, open and delete worktrees from a sidebar.",
  "version": "0.1.0",
  "publisher": "publisher-placeholder",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/publisher-placeholder/vscode-worktree.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "branch"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "worktree.create",
        "title": "Create Worktree...",
        "category": "Worktree",
        "icon": "$(add)"
      },
      {
        "command": "worktree.refresh",
        "title": "Refresh",
        "category": "Worktree",
        "icon": "$(refresh)"
      },
      {
        "command": "worktree.open",
        "title": "Open Worktree",
        "category": "Worktree"
      },
      {
        "command": "worktree.openInNewWindow",
        "title": "Open in New Window",
        "category": "Worktree",
        "icon": "$(empty-window)"
      },
      {
        "command": "worktree.openInCurrentWindow",
        "title": "Open in Current Window",
        "category": "Worktree"
      },
      {
        "command": "worktree.openTerminal",
        "title": "Open Terminal",
        "category": "Worktree",
        "icon": "$(terminal)"
      },
      {
        "command": "worktree.delete",
        "title": "Delete Worktree",
        "category": "Worktree",
        "icon": "$(trash)"
      },
      {
        "command": "worktree.prune",
        "title": "Prune Worktrees",
        "category": "Worktree"
      },
      {
        "command": "worktree.copyPath",
        "title": "Copy Path",
        "category": "Worktree"
      },
      {
        "command": "worktree.revealInOS",
        "title": "Reveal in File Explorer",
        "category": "Worktree"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktrees",
          "title": "Worktrees",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "worktrees": [
        {
          "id": "worktreeView",
          "name": "Worktrees",
          "contextualTitle": "Worktrees"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "worktree.create"
        },
        {
          "command": "worktree.refresh"
        },
        {
          "command": "worktree.prune"
        },
        {
          "command": "worktree.open"
        },
        {
          "command": "worktree.openInNewWindow",
          "when": "false"
        },
        {
          "command": "worktree.openInCurrentWindow",
          "when": "false"
        },
        {
          "command": "worktree.openTerminal",
          "when": "false"
        },
        {
          "command": "worktree.delete",
          "when": "false"
        },
        {
          "command": "worktree.copyPath",
          "when": "false"
        },
        {
          "command": "worktree.revealInOS",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "worktree.create",
          "when": "view == worktreeView",
          "group": "navigation@1"
        },
        {
          "command": "worktree.refresh",
          "when": "view == worktreeView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "worktree.openInNewWindow",
          "when": "view == worktreeView && viewItem =~ /^(main|current|other)$/",
          "group": "inline@1"
        },
        {
          "command": "worktree.openTerminal",
          "when": "view == worktreeView && viewItem =~ /^(main|current|other)$/",
          "group": "inline@2"
        },
        {
          "command": "worktree.openInCurrentWindow",
          "when": "view == worktreeView && viewItem =~ /^(main|current|other)$/",
          "group": "1_open@1"
        },
        {
          "command": "worktree.openTerminal",
          "when": "view == worktreeView && viewItem =~ /^(main|current|other)$/",
          "group": "1_open@2"
        },
        {
          "command": "worktree.prune",
          "when": "view == worktreeView && viewItem == prunable",
          "group": "1_open@3"
        },
        {
          "command": "worktree.delete",
          "when": "view == worktreeView && viewItem =~ /^(current|other)$/",
          "group": "7_modification@1"
        },
        {
          "command": "worktree.copyPath",
          "when": "view == worktreeView && viewItem =~ /^(main|current|other)$/",
          "group": "9_copy@1"
        },
        {
          "command": "worktree.revealInOS",
          "when": "view == worktreeView && viewItem =~ /^(main|current|other)$/",
          "group": "9_copy@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeView",
        "contents": "No folder is open.\n[Open Folder](command:vscode.openFolder)",
        "when": "worktree.state == noFolder"
      },
      {
        "view": "worktreeView",
        "contents": "The open folder is not a git repository.\n[Initialize Repository](command:git.init)",
        "when": "worktree.state == noRepository"
      },
      {
        "view": "worktreeView",
        "contents": "git was not found on your PATH, or it is older than 2.7 which is required for `git worktree list --porcelain`.\nSet `git.path` to the git binary and reload.\n[Open Settings](command:workbench.action.openSettings?%22git.path%22)",
        "when": "worktree.state == noGit"
      },
      {
        "view": "worktreeView",
        "contents": "No worktrees were found.\n[Create Worktree](command:worktree.create)",
        "when": "worktree.state == ready"
      }
    ],
    "configuration": {
      "title": "Worktree",
      "properties": {
        "worktree.baseDirectory": {
          "type": "string",
          "default": "${repoParent}/${repoName}.worktrees",
          "markdownDescription": "Directory new worktrees are created in. Supports `${repoRoot}`, `${repoParent}` and `${repoName}`."
        },
        "worktree.openBehavior": {
          "type": "string",
          "enum": [
            "newWindow",
            "currentWindow",
            "ask"
          ],
          "enumDescriptions": [
            "Open the worktree in a new window.",
            "Open the worktree in the current window, reloading it.",
            "Ask every time."
          ],
          "default": "newWindow",
          "description": "What Open Worktree and the open after create do."
        },
        "worktree.deleteBranchOnRemove": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask whether to delete the branch.",
            "Always delete the branch.",
            "Never delete the branch."
          ],
          "default": "ask",
          "description": "Branch cleanup after a worktree is removed."
        },
        "worktree.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "Open the new worktree after creating it."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "tsc -p tsconfig.integration.json && node out/test/integration/runTest.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "mocha": "^11.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
